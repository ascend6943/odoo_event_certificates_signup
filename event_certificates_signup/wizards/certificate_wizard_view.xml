<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_company_certificate_wizard_form" model="ir.ui.view">
        <field name="name">event.company.certificate.wizard.form</field>
        <field name="model">event.company.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Company Certificates">
                <group>
                    <field name="event_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="event_ids" widget="many2many_tags" options="{'no_create': True}" invisible="1"/>
                </group>
                <footer>
                    <button string="Print Certificates" name="action_print_certificates" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
