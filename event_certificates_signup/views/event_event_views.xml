<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_event_view_form_inherit_certificates" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.certificates</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="%(action_event_company_certificate_wizard)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-certificate"
                        string="Company Certificates"
                        groups="event.group_event_user"/>
                <button name="%(action_event_signup_sheet_wizard)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        string="Signup Sheets"
                        groups="event.group_event_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Certificates" name="certificates">
                    <group>
                        <field name="certificate_template_html"
                               placeholder="Optional: paste an HTML template using {{company}}, {{event_name}}, {{event_date}}, {{topics}} and {{presented_by}}"/>
                    </group>
                    <div class="text-muted">
                        Leave empty to use the default certificate layout. The template is used once per attending company.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
