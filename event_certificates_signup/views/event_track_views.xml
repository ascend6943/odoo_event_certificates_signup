<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_track_form_inherit_instructor_signature" model="ir.ui.view">
        <field name="name">event.track.form.inherit.instructor.signature</field>
        <field name="model">event.track</field>
        <field name="inherit_id" ref="website_event_track.view_event_track_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='speaker']" position="inside">
                <group string="Instructor Signature" name="instructor_signature_group">
                    <field name="instructor_signature" widget="image" class="oe_avatar"
                           placeholder="Transparent-background PNG signature"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
